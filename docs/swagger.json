        "/products": {
            "get": {
                "description": "根據查詢條件獲取商品列表,支援分頁、排序和篩選",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "products"
                ],
                "summary": "獲取商品列表",
                "parameters": [
                    {
                        "type": "string",
                        "description": "商品名稱",
                        "name": "name",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "類別 slug",
                        "name": "category",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "最低價格",
                        "name": "min_price",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "最高價格",
                        "name": "max_price",
                        "in": "query"
                    },
                    {
                        "type": "boolean",
                        "description": "是否啟用",
                        "name": "is_active",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "price",
                            "created_at",
                            "name"
                        ],
                        "type": "string",
                        "description": "排序欄位",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "type": "string",
                        "description": "排序方向",
                        "name": "sort_order",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "頁碼",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "每頁數量",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "獲取成功",
